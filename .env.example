# Public HTTP listener. Deploy behind TLS; do not expose this service directly over HTTP.
PORT=8787
HOST=0.0.0.0
PROJECTS_CONFIG_PATH=./config/projects.json
GATEWAY_ATTESTATION_KEY=
DATABASE_URL=postgres://user:password@host:5432/world_proof_gateway

# World RP signing key for Gateway's own owner/authentication flow. It must not
# be reused for tenant applications. Put it only into deployment secret storage.
RP_SIGNING_KEY=

# 32-byte base64url or 64-hex-character master key. Encrypts tenant RP signing
# keys at rest; rotate via a migration/KMS process, never by editing database rows.
GATEWAY_TENANT_ENCRYPTION_KEY=
GATEWAY_ADMIN_TOKEN=

# WLD billing plan: exactly 1 WLD (1,000,000 MiniKit atomic units) buys 5,000
# requests. Keep this API key server-only; checkout confirmations verify with it.
WLD_RECEIVER_ADDRESS=
WORLD_APP_ID=
WORLD_DEVELOPER_API_KEY=

# Set only after Postgres is provisioned. The starter deliberately runs in memory
# for tests/local demos and refuses production mode without a durable store.
NODE_ENV=development
