# Public HTTP listener. Deploy behind TLS; do not expose this service directly over HTTP.
PORT=8787
HOST=0.0.0.0
PROJECTS_CONFIG_PATH=./config/projects.json
GATEWAY_ATTESTATION_KEY=
DATABASE_URL=postgres://user:password@host:5432/world_proof_gateway

# RP signing key for the configured IdleMint World ID relying party.
# Put this only into the deployment secret store; never commit a real .env file.
IDLEMINT_RP_SIGNING_KEY=

# Set only after Postgres is provisioned. The starter deliberately runs in memory
# for tests/local demos and refuses production mode without a durable store.
NODE_ENV=development
